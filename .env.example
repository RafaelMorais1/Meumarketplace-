# Configurações do Ambiente
NODE_ENV=development
PORT=3000

# Conexão com o Banco de Dados PostgreSQL
# Opção A: PostgreSQL Local via Docker Compose
DATABASE_URL="postgres://postgres:postgrespassword@localhost:5432/marketplace_dev"
DATABASE_URL_TEST="postgres://postgres:postgrespassword@localhost:5432/marketplace_test"

# Opção B: PostgreSQL na Nuvem via Supabase (Utilizar Session Pooler na porta 5432)
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Segredo para assinatura de cookies ou criptografia auxiliar (mínimo 32 caracteres)
SESSION_SECRET="super-secret-random-string-with-at-least-32-characters"
